; Open Enderblossom, side plane: same head, but the stem bends down-right so that on the 45-degree wall model it runs
; straight into the log instead of ending in a flat cut that shows up as a slant. The leaf under it hangs straight
; down in texture space, which is down and in toward the log in world, so it ends against the log's core face
; below the side bump instead of dangling in front of it.
[palette]
. = transparent
o = #4B3E8CFF role=outline
s = #6E64C4FF role=shadow
b = #958FE2FF role=base
l = #BDB5F5FF role=light
h = #E4DCFFFF role=highlight
P = #3B0B55FF role=custom
M = #B02ADBFF role=custom
N = #E064F5FF role=custom
G = #FBD0FFFF role=accent
d = #1E3940FF role=dark
g = #2E6460FF role=base
k = #4F9283FF role=light

[grid]
................
......olbo......
.oo..olhbbo..oo.
ohlo.olbbso.olbo
olbbo.MMMM.olbso
.obbsMGNNMMsbbo.
..osMNPPPPMso...
.olbsMMNNMMsbso.
olbbso.MMM.osbbo
olbso.osgdo.osso
.oso.osskd..soo.
.......kgd......
........k.gd....
.......kgd.gd...
.......kgd..gd..
........dd...dd.
