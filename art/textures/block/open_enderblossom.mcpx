mcpx 1

[canvas]
width = 16
height = 16

[palette]
. = #00000000
o = #4B3E8CFF role=outline
s = #6E64C4FF role=shadow
b = #958FE2FF role=base
l = #BDB5F5FF role=light
h = #E4DCFFFF role=highlight
P = #3B0B55FF role=custom
M = #B02ADBFF role=custom
N = #E064F5FF role=custom
G = #FBD0FFFF role=accent
d = #1E3940FF role=dark
g = #2E6460FF role=base
k = #4F9283FF role=light

[layer base]
visible = true
opacity = 1.000

[grid]
................
......olbo......
.oo..olhbbo..oo.
ohlo.olbbso.olbo
olbbo.MMMM.olbso
.obbsMGNNMMsbbo.
..osMNPPPPMso...
.olbsMMNNMMsbso.
olbbso.MMM.osbbo
olbso.osgdo.osso
.oso.osskd..soo.
.......kgd......
......kk.gd.....
.....kgd.gd.....
......dd.gd.....
.........dd.....
