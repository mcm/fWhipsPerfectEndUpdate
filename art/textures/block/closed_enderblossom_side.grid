; Closed Enderblossom, side plane: same bud, but the stem bends down-right so that on the 45-degree wall model it runs
; straight into the log instead of ending in a flat cut that shows up as a slant.
[palette]
. = transparent
o = #4B3E8CFF role=outline
s = #6E64C4FF role=shadow
b = #958FE2FF role=base
l = #BDB5F5FF role=light
h = #E4DCFFFF role=highlight
P = #3B0B55FF role=custom
d = #1E3940FF role=dark
g = #2E6460FF role=base
k = #4F9283FF role=light

[grid]
................
................
.......oo.......
......olbo......
.....olhbso.....
....olhbbsso....
....olbbPbso....
...olhbbPbsso...
...olbbsPsbso...
...olbsoPosso...
....ososgosso...
.....ookgdoo....
.......kgd......
......kk.gd.....
.....kgd..gd....
.......dd..gd...
